+TEST_CASE("MIP-outer-gap-child-postsolve", "[highs_test_mip_solver][outer_gap]") {
+  for (bool stop : {false, true}) {
+    Highs highs;
+    highs.setOptionValue("output_flag", false);
+    highs.setOptionValue("threads", 1);
+    highs.setOptionValue("mip_rel_gap", 0.0);
+    highs.setOptionValue("mip_abs_gap", 0.0);
+    REQUIRE(highs.readModel(std::string(HIGHS_DIR) + "/check/instances/egout.mps")
+            == HighsStatus::kOk);
+    // Force a known child-presolve offset. The original child objective must
+    // contain this 300 exactly once, irrespective of its reduced offset.
+    REQUIRE(highs.addCol(100, 3, 3, 0, nullptr, nullptr) == HighsStatus::kOk);
+    HighsOptions options = highs.getOptions();
+    HighsLp lp = highs.getLp();
+    lp.offset_ = 0;
+    HighsCallback callback(nullptr);
+    HighsSolution empty;
+    highs::parallel::initialize_scheduler(1);
+    HighsTimer timer;
+    HighsProfiling profiling;
+    profiling.multi_threaded = false;
+    profiling.initialize(timer, false, false);
+    HighsMipSolver child(callback, options, lp, empty, true, 1);
+    child.setProfiling(&profiling);
+    child.outer_gap_goal_.active = true;
+    child.outer_gap_goal_.stop = stop;
+    child.outer_gap_goal_.lower_bound = 0;
+    child.outer_gap_goal_.offset = -300;
+    child.outer_gap_goal_.abs_gap = 1e8;
+    child.run();
+    REQUIRE(child.outer_gap_goal_.first_hit_time >= 0);
+    REQUIRE(child.solution_.size() == static_cast<size_t>(lp.num_col_));
+    REQUIRE(child.solution_.back() == 3);
+    HighsCDouble objective;
+    double bound_violation, row_violation, integrality_violation;
+    REQUIRE(child.solutionFeasible(&lp, child.solution_, nullptr,
+                                   bound_violation, row_violation,
+                                   integrality_violation, objective));
+    REQUIRE(child.solution_objective_ == Approx(double(objective)));
+    REQUIRE(child.termination_status_ == HighsModelStatus::kNotset);
+    if (stop) {
+      REQUIRE(child.outer_gap_goal_.stopped);
+      REQUIRE(child.modelstatus_ == HighsModelStatus::kSolutionLimit);
+    } else {
+      REQUIRE(!child.outer_gap_goal_.stopped);
+      REQUIRE(child.modelstatus_ == HighsModelStatus::kOptimal);
+      REQUIRE(child.solution_objective_ == Approx(868.1007));
+    }
+    highs.resetGlobalScheduler(true);
+  }
+}
