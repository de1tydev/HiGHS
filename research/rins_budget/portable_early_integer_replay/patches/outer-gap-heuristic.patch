@@ -71,6 +71,26 @@ HighsMipSolver::HighsMipSolver(HighsCallback& callback,
 
 HighsMipSolver::~HighsMipSolver() = default;
 
+bool HighsMipSolver::observeOuterGapGoal() {
+  // This state is private to the direct child and is not inherited by nested
+  // sub-MIPs. In particular it must never use the shared terminator.
+  if (!submip || !outer_gap_goal_.active ||
+      !std::isfinite(solution_objective_) ||
+      orig_model_->sense_ != ObjSense::kMinimize || orig_model_->offset_ != 0 ||
+      solution_.size() != static_cast<size_t>(orig_model_->num_col_) ||
+      !(bound_violation_ <= options_mip_->mip_feasibility_tolerance) ||
+      !(integrality_violation_ <= options_mip_->mip_feasibility_tolerance) ||
+      !(row_violation_ <= options_mip_->mip_feasibility_tolerance) ||
+      !outer_gap_goal_.reached(solution_objective_))
+    return false;
+  if (outer_gap_goal_.first_hit_time < 0) {
+    outer_gap_goal_.first_hit_time = timer_.read();
+    outer_gap_goal_.first_hit_objective = solution_objective_;
+  }
+  return true;
+}
