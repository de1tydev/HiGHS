+// A heuristic scheduling goal, never a bound/proof for the outer MIP.
+// All values use the parent's normalized minimization coordinates. The child
+// original model has the parent's costs and zero offset; child presolve offsets
+// are already included in its postsolved solution_objective_.
+struct HighsMipOuterGapGoal {
+  bool active = false;
+  bool stop = false;
+  bool stopped = false;
+  double lower_bound = -kHighsInf;
+  double offset = 0;
+  double abs_gap = 0;
+  double rel_gap = 0;
+  double first_hit_time = -1;
+  double first_hit_objective = kHighsInf;
+
+  bool reached(double child_objective) const {
+    if (!active || !std::isfinite(child_objective) ||
+        !std::isfinite(lower_bound) || !std::isfinite(offset) ||
+        !std::isfinite(abs_gap) || !std::isfinite(rel_gap) || abs_gap < 0 ||
+        rel_gap < 0 || child_objective < lower_bound)
+      return false;
+    // Do not invert a relative-gap expression into a positive-objective-only
+    // threshold. Extended precision also avoids cancellation of large offsets
+    // in the numerator. Fail closed if arithmetic is not finite.
+    const long double gap =
+        static_cast<long double>(child_objective) - lower_bound;
+    const long double objective =
+        static_cast<long double>(child_objective) + offset;
+    const long double relative_limit = rel_gap * std::fabs(objective);
+    if (!std::isfinite(gap) || !std::isfinite(objective) ||
+        !std::isfinite(relative_limit))
+      return false;
+    return gap <= abs_gap || gap <= relative_limit;
+  }
+};
