+// Experimental outer-gap heuristic return tests. These exercise the private
+// scheduling goal; proof and candidate acceptance still belong to the parent.
+
+TEST_CASE("MIP-outer-gap-predicate", "[highs_test_mip_solver][outer_gap]") {
+  HighsMipOuterGapGoal goal;
+  REQUIRE(!goal.reached(100));
+  goal.active = true;
+  goal.lower_bound = 100;
+  goal.rel_gap = 0.005;
+  REQUIRE(goal.reached(100.4));
+  REQUIRE(!goal.reached(100.6));
+  REQUIRE(!goal.reached(99));  // inconsistent bound fails closed
+  goal.offset = 1000;
+  REQUIRE(goal.reached(105));
+  REQUIRE(!goal.reached(106));
+  goal.offset = -1000;
+  REQUIRE(goal.reached(104));  // negative normalized outer objective
+  REQUIRE(!goal.reached(105));
+  goal.offset = -100;
+  REQUIRE(goal.reached(100));  // exact zero, zero absolute gap
+  REQUIRE(!goal.reached(100.000001));
+  goal.abs_gap = 0.00001;
+  REQUIRE(goal.reached(100.000001));
+  goal.lower_bound = -1;
+  goal.offset = 0;
+  goal.abs_gap = 0;
+  goal.rel_gap = 0.99;
+  REQUIRE(!goal.reached(0));
+  REQUIRE(!goal.reached(1));  // crosses zero, gap=2 rather than 1
+  goal.rel_gap = 2;
+  REQUIRE(goal.reached(1));
+  goal.rel_gap = 0;
+  goal.abs_gap = 2;
+  REQUIRE(goal.reached(1));  // equality is permitted for scheduling only
+  goal.abs_gap = std::nextafter(2.0, 0.0);
+  REQUIRE(!goal.reached(1));
+
+  // The ratio is invariant under minimization normalization of a maximum.
+  goal.lower_bound = -110;
+  goal.offset = -500;
+  goal.rel_gap = 0.01;
+  goal.abs_gap = 0;
+  REQUIRE(goal.reached(-105));  // raw maximizing incumbent 605, bound 610
+  REQUIRE(!goal.reached(-100));
+  goal.lower_bound = 100;
+  goal.offset = 1e20;
+  goal.rel_gap = 0;
+  REQUIRE(!goal.reached(101));  // avoid cancellation via (q+O)-(L+O)
+  goal.abs_gap = 1;
+  REQUIRE(goal.reached(101));
+  REQUIRE(!goal.reached(kHighsInf));
+  REQUIRE(!goal.reached(-kHighsInf));
+  REQUIRE(!goal.reached(std::numeric_limits<double>::quiet_NaN()));
+  for (double bad : {kHighsInf, -kHighsInf,
+                     std::numeric_limits<double>::quiet_NaN()}) {
+    HighsMipOuterGapGoal invalid = goal;
+    invalid.lower_bound = bad;
+    REQUIRE(!invalid.reached(101));
+    invalid = goal;
+    invalid.offset = bad;
+    REQUIRE(!invalid.reached(101));
+    invalid = goal;
+    invalid.rel_gap = bad;
+    REQUIRE(!invalid.reached(101));
+    invalid = goal;
+    invalid.abs_gap = bad;
+    REQUIRE(!invalid.reached(101));
+  }
+  goal.abs_gap = -1;
+  REQUIRE(!goal.reached(100));
+  goal.abs_gap = 0;
+  goal.rel_gap = -1;
+  REQUIRE(!goal.reached(100));
+}
+
+TEST_CASE("MIP-outer-gap-local-stop", "[highs_test_mip_solver][outer_gap]") {
+  Highs high;
+  high.setOptionValue("output_flag", false);
+  HighsOptions options = high.getOptions();
+  REQUIRE(!options.mip_heuristic_outer_gap);
+  REQUIRE(!options.mip_heuristic_outer_gap_log);
+  // This public user target must continue to be ignored in a child.
+  options.objective_target = 1e9;
+  HighsCallback callback(nullptr);
+  HighsLp lp;
+  lp.num_col_ = 1;
+  lp.col_cost_ = {1};
+  lp.col_lower_ = {0};
+  lp.col_upper_ = {200};
+  lp.integrality_ = {HighsVarType::kInteger};
+  lp.a_matrix_.num_col_ = 1;
+  lp.a_matrix_.start_ = {0, 0};
+  HighsSolution no_solution;
+  HighsMipSolver child(callback, options, lp, no_solution, true, 1);
+  child.mipdata_.reset(new HighsMipSolverData(child));
+  child.modelstatus_ = HighsModelStatus::kNotset;
+  child.timer_.start();
+  HighsMipOuterGapGoal& goal = child.outer_gap_goal_;
+  goal.active = true;
+  goal.lower_bound = 99;
+  goal.abs_gap = 1;
+  child.solution_objective_ = 100;
+  child.solution_ = {100};
+  child.bound_violation_ = child.integrality_violation_ = child.row_violation_ = 0;
+  child.mipdata_->lower_bound = 1e8;  // restricted child bound is irrelevant
+  REQUIRE(child.observeOuterGapGoal());
+  REQUIRE(goal.first_hit_time >= 0);
+  REQUIRE(goal.first_hit_objective == 100);
+  REQUIRE(!child.mipdata_->checkLimits());  // observation-only
+  REQUIRE(child.modelstatus_ == HighsModelStatus::kNotset);
+  const double first_hit = goal.first_hit_time;
+  child.solution_objective_ = 99;
+  REQUIRE(child.observeOuterGapGoal());
+  REQUIRE(goal.first_hit_time == first_hit);
+  goal.stop = true;
+  for (double invalid : {1.0, kHighsInf,
+                         std::numeric_limits<double>::quiet_NaN()}) {
+    child.row_violation_ = invalid;
+    REQUIRE(!child.mipdata_->checkLimits());
+  }
+  child.row_violation_ = 0;
+  child.solution_.clear();
+  REQUIRE(!child.mipdata_->checkLimits());
+  child.solution_ = {99};
+  lp.sense_ = ObjSense::kMaximize;
+  REQUIRE(!child.mipdata_->checkLimits());
+  lp.sense_ = ObjSense::kMinimize;
+  lp.offset_ = 1;
+  REQUIRE(!child.mipdata_->checkLimits());
+  lp.offset_ = 0;
+  REQUIRE(child.mipdata_->checkLimits());
+  REQUIRE(goal.stopped);
+  REQUIRE(child.modelstatus_ == HighsModelStatus::kSolutionLimit);
+  REQUIRE(child.termination_status_ == HighsModelStatus::kNotset);
+  // A newly constructed nested child does not inherit the goal.
+  HighsMipSolver nested(callback, options, lp, no_solution, true, 2);
+  REQUIRE(!nested.outer_gap_goal_.active);
+  child.timer_.stop();
+  high.resetGlobalScheduler(true);
+}
