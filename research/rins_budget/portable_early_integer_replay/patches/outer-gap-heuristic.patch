+TEST_CASE("MIP-outer-gap-outer-regression", "[highs_test_mip_solver][outer_gap]") {
+  for (bool maximize : {false, true}) {
+    for (const std::string presolve : {kHighsOnString, kHighsOffString}) {
+      double objective = 0;
+      int64_t nodes = -1;
+      HighsInt iterations = -1;
+      for (int mode = 0; mode != 3; ++mode) {
+        Highs highs;
+        highs.setOptionValue("output_flag", false);
+        highs.setOptionValue("threads", 1);
+        highs.setOptionValue("presolve", presolve);
+        highs.setOptionValue("mip_rel_gap", 0.005);
+        highs.setOptionValue("mip_heuristic_outer_gap_log", mode == 1);
+        highs.setOptionValue("mip_heuristic_outer_gap", mode == 2);
+        REQUIRE(highs.readModel(std::string(HIGHS_DIR) +
+                                "/check/instances/egout.mps") == HighsStatus::kOk);
+        REQUIRE(highs.addCol(100, 3, 3, 0, nullptr, nullptr) == HighsStatus::kOk);
+        HighsLp lp = highs.getLp();
+        lp.offset_ = -900;
+        if (maximize) {
+          for (double& cost : lp.col_cost_) cost = -cost;
+          lp.offset_ = -lp.offset_;
+          lp.sense_ = ObjSense::kMaximize;
+        }
+        REQUIRE(highs.passModel(lp) == HighsStatus::kOk);
+        REQUIRE(highs.run() == HighsStatus::kOk);
+        REQUIRE(highs.getModelStatus() == HighsModelStatus::kOptimal);
+        REQUIRE(highs.getInfo().primal_solution_status == kSolutionStatusFeasible);
+        REQUIRE(highs.getInfo().mip_gap <= 0.005);
+        if (mode == 0) {
+          objective = highs.getInfo().objective_function_value;
+          nodes = highs.getInfo().mip_node_count;
+          iterations = highs.getInfo().simplex_iteration_count;
+        } else {
+          REQUIRE(highs.getInfo().objective_function_value == Approx(objective));
+          if (mode == 1) {  // observing must not alter search decisions
+            REQUIRE(highs.getInfo().mip_node_count == nodes);
+            REQUIRE(highs.getInfo().simplex_iteration_count == iterations);
+          }
+        }
+        highs.resetGlobalScheduler(true);
+      }
+    }
+  }
+}
+
+TEST_CASE("MIP-outer-gap-parent-integration",
+          "[highs_test_mip_solver][outer_gap]") {
+  for (bool maximize : {false, true}) {
+    for (bool parallel : {false, true}) {
+      Highs highs;
+      highs.setOptionValue("output_flag", true);
+      highs.setOptionValue("log_to_console", false);
+      highs.setOptionValue("threads", parallel ? 2 : 1);
+      highs.setOptionValue("parallel", parallel ? kHighsOnString : kHighsOffString);
+      highs.setOptionValue("mip_rel_gap", 0.02);
+      highs.setOptionValue("mip_heuristic_effort", 0.5);
+      highs.setOptionValue("mip_heuristic_outer_gap", true);
+      highs.setOptionValue("mip_heuristic_outer_gap_log", true);
+      REQUIRE(highs.readModel(std::string(HIGHS_DIR) + "/check/instances/rgn.mps")
+              == HighsStatus::kOk);
+      REQUIRE(highs.addCol(100, 3, 3, 0, nullptr, nullptr) == HighsStatus::kOk);
+      HighsLp lp = highs.getLp();
+      lp.offset_ = 100;
+      if (maximize) {
+        for (double& cost : lp.col_cost_) cost = -cost;
+        lp.offset_ = -lp.offset_;
+        lp.sense_ = ObjSense::kMaximize;
+      }
+      REQUIRE(highs.passModel(lp) == HighsStatus::kOk);
+      std::string log;
+      highs.setCallback(
+          [&](int type, const std::string& message, const HighsCallbackOutput*,
+              HighsCallbackInput*, void*) {
+            if (type == kCallbackLogging) log += message;
+          }, nullptr);
+      REQUIRE(highs.startCallback(kCallbackLogging) == HighsStatus::kOk);
+      REQUIRE(highs.run() == HighsStatus::kOk);
+      REQUIRE(highs.getModelStatus() == HighsModelStatus::kOptimal);
+      REQUIRE(highs.getInfo().primal_solution_status == kSolutionStatusFeasible);
+      REQUIRE(highs.getInfo().mip_gap <= 0.02);
+      if (parallel) {
+        // Even a serial root phase is unsupported if parallel workers may
+        // subsequently be launched: no active goal or instrumentation.
+        REQUIRE(log.find("OuterGap") == std::string::npos);
+      } else {
+        INFO(log);
+        REQUIRE(log.find("OuterGap child: active=1 stop=1 stopped=1") !=
+                std::string::npos);
+        REQUIRE(log.find("OuterGap parent: accepted=1 improved=1") !=
+                std::string::npos);
+        REQUIRE(log.find("offset=400 ") != std::string::npos);
+      }
+      highs.resetGlobalScheduler(true);
+    }
+  }
+}
