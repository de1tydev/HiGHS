index 0000000000..45c725a23c
--- /dev/null
+++ b/highs/mip/HighsCmirCoefficientCache.h
@@ -0,0 +1,29 @@
+#ifndef MIP_HIGHS_CMIR_COEFFICIENT_CACHE_H_
+#define MIP_HIGHS_CMIR_COEFFICIENT_CACHE_H_
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+#include "lp_data/HConst.h"
+
+// One fixed-scale complement loop. Call refresh after each coefficient change.
+// Only deterministic scalar arithmetic is cached, never an efficacy or a cut.
+class HighsCmirCoefficientCache {
+ public:
+  struct Value { double down = 0; double fractional = 0; };
+  HighsCmirCoefficientCache(size_t size, double scale)
+      : entries_(size), scale_(scale) {}
+  void refresh(size_t index, double coefficient) {
+    const double scaled = coefficient * scale_;
+    const double shifted = scaled + kHighsTiny;
+    Value& value = entries_[index];
+    value.down = (int64_t)shifted - (shifted < (int64_t)shifted);
+    value.fractional = scaled - value.down;
+    ++computations;
+  }
+  const Value& get(size_t index) const { return entries_[index]; }
+  uint64_t computations = 0;
+ private:
+  std::vector<Value> entries_;
+  const double scale_;
+};
+#endif
