+HighsInt HighsSeparation::stagedRootRound(
+    HighsDomain& domain, HighsLpRelaxation::Status& status, RootStats& stats) {
+  HighsMipSolverData& data = *lp->getMipSolver().mipdata_;
+  const bool observe = observing_root_ != nullptr;
+  HighsInt ncuts = 0;
+  bool added_batch = false;
+  bool aged = false;
+
+  auto resolve = [&]() {
+    lp->setObjectiveLimit(mipworker_.upper_limit);
+    status = lp->resolveLp(&domain);
+    stats.fresh_solve = true;
+  };
+  auto redcost = [&]() {
+    if (lp->unscaledDualFeasible(status)) {
+      data.redcostfixing.addRootRedcost(
+          data.mipsolver, lp->getSolution().col_dual, lp->getObjective());
+      if (mipworker_.upper_limit != kHighsInf)
+        data.redcostfixing.propagateRootRedcost(data.mipsolver);
+    }
+  };
+  auto propagate = [&]() -> bool {
+    if (domain.infeasible() || mipworker_.getGlobalDomain().infeasible()) {
+      status = HighsLpRelaxation::Status::kInfeasible;
+      domain.clearChangedCols();
+      return false;
+    }
+    domain.propagate();
+    if (domain.infeasible()) {
+      status = HighsLpRelaxation::Status::kInfeasible;
+      domain.clearChangedCols();
+      return false;
+    }
+    data.cliquetable.cleanupFixed(data.getDomain());
+    if (mipworker_.getGlobalDomain().infeasible()) {
+      status = HighsLpRelaxation::Status::kInfeasible;
+      domain.clearChangedCols();
+      return false;
+    }
+    ncuts += static_cast<HighsInt>(domain.getChangedCols().size());
+    while (!domain.getChangedCols().empty()) {
+      stats.domain_changes += static_cast<HighsInt>(domain.getChangedCols().size());
+      resolve();
+      if (!lp->scaledOptimal(status)) return false;
+      redcost();
+    }
+    return true;
+  };
+  auto settle = [&]() -> bool {
+    if (!lp->scaledOptimal(status)) return false;
+    redcost();
+    return propagate();
+  };
+  auto ageAndRefresh = [&]() {
+    if (!added_batch || aged) return;
+    aged = true;
+    const HighsInt before = lp->numRows();
+    lp->performAging(true);
+    // removeCuts performs a raw LP0 solve, which does not refresh the
+    // relaxation's status, objective or fractional list. Reacquire all three.
+    if (lp->numRows() != before) {
+      resolve();
+      settle();
+    }
+  };
+  auto selectAndSolve = [&](bool age_unviolated, bool cheap) {
+    SepaClock::time_point start;
+    if (observe) start = SepaClock::now();
+    mipworker_.getCutPool().separate(
+        lp->getSolution().col_value, domain, cutset, data.feastol,
+        data.cutpools, false, age_unviolated);
+    if (age_unviolated) ++stats.pool_age_passes;
+    if (&mipworker_.getCutPool() != &data.getCutPool()) {
+      data.getCutPool().separate(lp->getSolution().col_value, domain, cutset,
+                                data.feastol, data.cutpools, true,
+                                age_unviolated);
+    }
+    if (observe) stats.pool_seconds += sepaElapsed(start);
+    const HighsInt selected = cutset.numCuts();
+    if (cheap) {
+      stats.cheap_cuts = selected;
+      stats.cheap_nnz = static_cast<HighsInt>(cutset.ARindex_.size());
+    }
+    if (selected == 0) return;
+    ncuts += selected;
+    added_batch = true;
+    lp->addCuts(cutset);
+    resolve();
+    settle();
+  };
+
+  // Do not inspect solution arrays on exceptional entry, even though the
+  // ordinary root loop normally calls us only for a fractional optimal LP.
+  if (domain.infeasible() || !lp->scaledOptimal(status)) {
+    stats.skip = rootStop(domain, status);
+    return 0;
+  }
+  data.implications.separateImpliedBounds(
+      *lp, lp->getSolution().col_value, mipworker_.getCutPool(), data.feastol,
+      mipworker_.getGlobalDomain(), false);
+  if (!propagate()) {
+    stats.skip = rootStop(domain, status);
+    return ncuts;
+  }
+  data.cliquetable.separateCliques(
+      lp->getMipSolver(), lp->getSolution().col_value, mipworker_.getCutPool(),
+      data.feastol, data.cliquetable.getRandgen(),
+      data.cliquetable.getNumNeighbourhoodQueries());
+  if (!propagate()) {
+    stats.skip = rootStop(domain, status);
+    return ncuts;
+  }
+
+  {
+    SepaClock::time_point start;
+    if (observe) start = SepaClock::now();
+    HighsTransformedLp trans(*lp, data.implications,
+                            mipworker_.getGlobalDomain());
+    if (mipworker_.getGlobalDomain().infeasible()) {
+      status = HighsLpRelaxation::Status::kInfeasible;
+      stats.skip = RootStop::kDomainInfeasible;
+      return ncuts;
+    }
+    HighsLpAggregator aggregator(*lp);
+    ++stats.rebuilds;
+    if (observe) stats.rebuild_seconds += sepaElapsed(start);
+    separators[0]->run(*lp, aggregator, trans, mipworker_.getCutPool());
+  }
+  // No transformed row/column/basis state survives this boundary.
+  if (!propagate()) {
+    stats.skip = rootStop(domain, status);
+    return ncuts;
+  }
+  const auto cheap_before = lp->getSeparationWork();
+  const int64_t cheap_iterations = lp->getNumLpIterations();
+  auto recordCheap = [&]() {
+    const auto& work = lp->getSeparationWork();
+    stats.cheap_lp_calls = work.calls - cheap_before.calls;
+    stats.cheap_lp_seconds = work.seconds - cheap_before.seconds;
+    stats.cheap_lp_iterations = lp->getNumLpIterations() - cheap_iterations;
+  };
+  selectAndSolve(false, true);
+  RootStop stop = rootStop(domain, status);
+  if (stop != RootStop::kNone) {
+    ageAndRefresh();
+    stop = rootStop(domain, status);
+    if (stop != RootStop::kNone) {
+      stats.skip = stop;
+      recordCheap();
+      return ncuts;
+    }
+  }
+  recordCheap();
+
+  // Settling after the cheap solve is complete before rebuilding snapshots.
+  {
+    SepaClock::time_point start;
+    if (observe) start = SepaClock::now();
+    HighsTransformedLp trans(*lp, data.implications,
+                            mipworker_.getGlobalDomain());
+    if (!mipworker_.getGlobalDomain().infeasible()) {
+      HighsLpAggregator aggregator(*lp);
+      ++stats.rebuilds;
+      if (observe) stats.rebuild_seconds += sepaElapsed(start);
+      for (size_t i = 1; i < separators.size(); ++i) {
+        separators[i]->run(*lp, aggregator, trans, mipworker_.getCutPool());
+        if (mipworker_.getGlobalDomain().infeasible()) break;
+      }
+    }
+  }
+  if (propagate()) selectAndSolve(true, false);
+  ageAndRefresh();
+  return ncuts;
+}
