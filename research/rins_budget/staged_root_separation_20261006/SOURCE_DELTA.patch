+bool HighsSeparation::rootStagingEligible(const HighsDomain& propdomain) const {
+  const HighsMipSolver& solver = lp->getMipSolver();
+  const HighsMipSolverData& data = *solver.mipdata_;
+  return solver.options_mip_->parallel == kHighsOffString &&
+         !data.parallelLockActive() && solver.getMaxNumWorkers() == 1 &&
+         &propdomain == &data.getDomain() && lp == &data.getLp();
+}
