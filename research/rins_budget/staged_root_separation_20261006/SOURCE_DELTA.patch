+#include "HCheckConfig.h"
+#include "Highs.h"
+#include "catch.hpp"
+#include "mip/HighsMipSolver.h"
+#include "mip/HighsMipSolverData.h"
+#include "mip/HighsSeparation.h"
+
+#include <cmath>
+
+// Only the explicitly labelled controlled-state tests use this access. Public
+// solves and the triangle root test below use actual native LP/MIP states.
+struct HighsStagedRootTestAccess {
+  static void status(HighsLpRelaxation& lp, HighsLpRelaxation::Status status) {
+    lp.status = status;
+    lp.fractionalints.clear();
+  }
+  static bool eligible(const HighsSeparation& sepa, const HighsDomain& domain) {
+    return sepa.rootStagingEligible(domain);
+  }
+};
+
+namespace {
+using LpStatus = HighsLpRelaxation::Status;
+
+HighsLp triangle() {
+  HighsLp lp;
+  lp.num_col_ = 3;
+  lp.num_row_ = 3;
+  lp.col_cost_ = {1, 1, 1};
+  lp.col_lower_ = {0, 0, 0};
+  lp.col_upper_ = {1, 1, 1};
+  lp.integrality_.assign(3, HighsVarType::kInteger);
+  lp.row_lower_ = {1, 1, 1};
+  lp.row_upper_.assign(3, kHighsInf);
+  lp.a_matrix_.format_ = MatrixFormat::kColwise;
+  lp.a_matrix_.start_ = {0, 2, 4, 6};
+  lp.a_matrix_.index_ = {0, 2, 0, 1, 1, 2};
+  lp.a_matrix_.value_.assign(6, 1);
+  return lp;
+}
+
+HighsLp integralCover() {
+  HighsLp lp = triangle();
+  lp.num_col_ = 2;
+  lp.num_row_ = 1;
+  lp.col_cost_ = {1, 1};
+  lp.col_lower_ = {0, 0};
+  lp.col_upper_ = {1, 1};
+  lp.integrality_.assign(2, HighsVarType::kInteger);
+  lp.row_lower_ = {1};
+  lp.row_upper_ = {kHighsInf};
+  lp.a_matrix_.start_ = {0, 1, 2};
+  lp.a_matrix_.index_ = {0, 0};
+  lp.a_matrix_.value_ = {1, 1};
+  return lp;
+}
+
+// Same native initialization stages as HighsMipSolver::run, stopped before
+// root heuristics. This fixture does not manufacture a separation success.
+struct RootFixture {
+  Highs highs;
+  HighsCallback callback;
+  HighsProfiling profiling;
+  std::unique_ptr<HighsMipSolver> mip;
+  explicit RootFixture(const HighsLp& lp = triangle()) : callback(&highs) {
+    REQUIRE(highs.setOptionValue("output_flag", false) == HighsStatus::kOk);
+    REQUIRE(highs.setOptionValue("log_dev_level", 2) == HighsStatus::kOk);
+    REQUIRE(highs.setOptionValue("presolve", "off") == HighsStatus::kOk);
+    REQUIRE(highs.setOptionValue("parallel", "off") == HighsStatus::kOk);
+    REQUIRE(highs.setOptionValue("threads", 1) == HighsStatus::kOk);
+    REQUIRE(highs.setOptionValue("mip_detect_symmetry", false) == HighsStatus::kOk);
+    REQUIRE(highs.passModel(lp) == HighsStatus::kOk);
+    HighsTaskExecutor::initialize(1);
+    HighsSolution none;
+    mip.reset(new HighsMipSolver(callback, highs.getOptions(), highs.getLp(), none));
+    // These run-owned fields are not initialized by the MIP constructor.
+    mip->improving_solution_file_ = nullptr;
+    mip->modelstatus_ = HighsModelStatus::kNotset;
+    mip->timer_.start();
+    profiling.initialize(mip->timer_, true, true);
+    mip->setProfiling(&profiling);
+    mip->mipdata_.reset(new HighsMipSolverData(*mip));
+    data().getLp().setProfiling(&profiling);
+    data().init();
+    data().runMipPresolve(kHighsIInf);
+    data().runSetup();
+    REQUIRE_FALSE(data().getDomain().infeasible());
+    data().workers.emplace_back(*mip, &data().getLp(), &data().getDomain(),
+                                &data().getCutPool(), &data().getConflictPool(),
+                                &data().getPseudoCost());
+    data().getLp().setMipWorker(worker());
+    data().getLp().loadModel();
+  }
+  ~RootFixture() {
+    mip.reset();
+    highs.resetGlobalScheduler(true);
+  }
+  HighsMipSolverData& data() { return *mip->mipdata_; }
+  HighsMipWorker& worker() { return data().workers.front(); }
+  HighsSeparation& sepa() { return *worker().sepa_ptr_; }
+  LpStatus solveLp() {
+    return data().getLp().resolveLp(&data().getDomain());
+  }
+};
+}  // namespace
+
+TEST_CASE("staged-root-default-off-parity", "[staged-root-separation]") {
+  std::vector<double> point;
+  HighsInt iterations = -1;
+  int64_t nodes = -1;
+  for (int explicit_off = 0; explicit_off != 2; ++explicit_off) {
+    Highs highs;
+    highs.setOptionValue("output_flag", false);
+    highs.setOptionValue("threads", 1);
+    highs.setOptionValue("parallel", "off");
+    highs.setOptionValue("presolve", "off");
+    bool value = true;
+    REQUIRE(highs.getOptionValue("mip_staged_root_separation", value) == HighsStatus::kOk);
+    REQUIRE_FALSE(value);
+    if (explicit_off) highs.setOptionValue("mip_staged_root_separation", false);
+    REQUIRE(highs.passModel(triangle()) == HighsStatus::kOk);
+    REQUIRE(highs.run() == HighsStatus::kOk);
+    REQUIRE(highs.getModelStatus() == HighsModelStatus::kOptimal);
+    REQUIRE(highs.getInfo().objective_function_value == Approx(2));
+    if (!explicit_off) {
+      point = highs.getSolution().col_value;
+      iterations = highs.getInfo().simplex_iteration_count;
+      nodes = highs.getInfo().mip_node_count;
+    } else {
+      REQUIRE(highs.getSolution().col_value == point);
+      REQUIRE(highs.getInfo().simplex_iteration_count == iterations);
+      REQUIRE(highs.getInfo().mip_node_count == nodes);
+    }
+    highs.resetGlobalScheduler(true);
+  }
+}
+
+TEST_CASE("staged-root-public-sense-offset-correctness",
+          "[staged-root-separation]") {
+  for (ObjSense sense : {ObjSense::kMinimize, ObjSense::kMaximize}) {
+    for (double offset : {-100.0, 100.0}) {
+      Highs highs;
+      highs.setOptionValue("output_flag", false);
+      highs.setOptionValue("threads", 1);
+      highs.setOptionValue("parallel", "off");
+      highs.setOptionValue("presolve", "off");
+      highs.setOptionValue("mip_rel_gap", 0.0);
+      REQUIRE(highs.setOptionValue("mip_staged_root_separation", true) ==
+              HighsStatus::kOk);
+      HighsLp lp = triangle();
+      lp.sense_ = sense;
+      lp.offset_ = offset;
+      if (sense == ObjSense::kMaximize) lp.col_cost_.assign(3, -1);
+      REQUIRE(highs.passModel(lp) == HighsStatus::kOk);
+      REQUIRE(highs.run() == HighsStatus::kOk);
+      REQUIRE(highs.getModelStatus() == HighsModelStatus::kOptimal);
+      const double expected = offset + (sense == ObjSense::kMinimize ? 2 : -2);
+      REQUIRE(highs.getInfo().objective_function_value == Approx(expected));
+      REQUIRE(highs.getInfo().mip_dual_bound == Approx(expected));
+      const auto& x = highs.getSolution().col_value;
+      REQUIRE(x.size() == 3);
+      for (double v : x) {
+        REQUIRE(std::isfinite(v));
+        REQUIRE(v >= -1e-6);
+        REQUIRE(v <= 1 + 1e-6);
+        REQUIRE(std::abs(v - std::round(v)) <= 1e-6);
+      }
+      REQUIRE(x[0] + x[1] >= 1 - 1e-6);
+      REQUIRE(x[1] + x[2] >= 1 - 1e-6);
+      REQUIRE(x[0] + x[2] >= 1 - 1e-6);
+      REQUIRE(offset + (sense == ObjSense::kMinimize ? 1 : -1) *
+                           (x[0] + x[1] + x[2]) == Approx(expected));
+      highs.resetGlobalScheduler(true);
+    }
+  }
+}
+
+TEST_CASE("staged-root-pool-aging-and-membership", "[staged-root-separation]") {
+  RootFixture f;
+  auto& pool = f.data().getCutPool();
+  pool.setAgeLimit(2);
+  HighsInt inds[] = {0, 1};
+  double vals[] = {1, 1};
+  const HighsInt id = pool.addCut(*f.mip, inds, vals, 2, 1,
+                                 true, false, false);
+  REQUIRE(id >= 0);
+  HighsCutSet cuts;
+  const HighsInt before = pool.getNumCuts();
+  const std::vector<double> unviolated(3, 0);
+  for (int i = 0; i != 3; ++i) {
+    pool.separate(unviolated, f.data().getDomain(), cuts, f.data().feastol,
+                  f.data().cutpools, false, false);
+    REQUIRE(cuts.numCuts() == 0);
+    REQUIRE(pool.getNumCuts() == before);
+  }
+  // Age normally once: suppression above must not have advanced the cut.
+  pool.separate(unviolated, f.data().getDomain(), cuts, f.data().feastol,
+                f.data().cutpools);
+  REQUIRE(pool.getNumCuts() == before);
+  const std::vector<double> violated(3, 1);
+  pool.separate(violated, f.data().getDomain(), cuts, f.data().feastol,
+                f.data().cutpools, false, false);
+  REQUIRE(cuts.numCuts() == 1);
+  REQUIRE(cuts.cutindices.front() == id);
+  REQUIRE(pool.getNumAvailableCuts() == before - 1);
+  cuts.clear();
+  pool.separate(violated, f.data().getDomain(), cuts, f.data().feastol,
+                f.data().cutpools, false, false);
+  REQUIRE(cuts.numCuts() == 0);  // Already marked in the LP, not selected twice.
+  pool.lpCutRemoved(id);
+  REQUIRE(pool.getNumAvailableCuts() == before);
+  pool.resetAge(id);  // lpCutRemoved returns a cut at age one, not zero.
+  pool.separate(unviolated, f.data().getDomain(), cuts, f.data().feastol,
+                f.data().cutpools);
+  REQUIRE(pool.getNumCuts() == before);
+  pool.separate(unviolated, f.data().getDomain(), cuts, f.data().feastol,
+                f.data().cutpools);
+  REQUIRE(pool.getNumCuts() == before - 1);
+}
+
+TEST_CASE("staged-root-real-checkpoint-and-aging", "[staged-root-separation]") {
+  RootFixture f;
+  f.highs.setOptionValue("mip_staged_root_separation", true);
+  LpStatus status = f.solveLp();
+  REQUIRE(status == LpStatus::kOptimal);
+  REQUIRE_FALSE(f.data().getLp().getFractionalIntegers().empty());
+  const auto before = f.data().getLp().getSeparationWork();
+  const int64_t iterations_before = f.data().getLp().getNumLpIterations();
+  HighsSeparation::RootStats stats;
+  f.sepa().separationRoundAtRoot(f.data().getDomain(), status, stats);
+  REQUIRE(stats.eligible);
+  REQUIRE(stats.active);
+  const auto after = f.data().getLp().getSeparationWork();
+  REQUIRE(after.aging_calls - before.aging_calls <= 1);
+  REQUIRE(stats.pool_age_passes <= 1);
+  REQUIRE(stats.rebuilds <= 2);
+  if (stats.cheap_cuts > 0) {
+    REQUIRE(stats.fresh_solve);
+    REQUIRE(stats.cheap_lp_calls >= 1);
+  }
+  if (stats.path_calls && stats.cheap_cuts > 0) REQUIRE(stats.rebuilds == 2);
+  f.data().total_lp_iterations +=
+      f.data().getLp().getNumLpIterations() - iterations_before;
+  status = f.data().evaluateRootLp(f.worker(), stats.fresh_solve);
+  REQUIRE(status != LpStatus::kError);
+  if (!f.mip->solution_.empty()) {
+    const auto& x = f.mip->solution_;
+    REQUIRE(x.size() == 3);
+    REQUIRE(x[0] + x[1] >= 1 - 1e-6);
+    REQUIRE(x[1] + x[2] >= 1 - 1e-6);
+    REQUIRE(x[0] + x[2] >= 1 - 1e-6);
+    for (double v : x) REQUIRE(std::abs(v - std::round(v)) <= 1e-6);
+  }
+}
+
+TEST_CASE("staged-root-fresh-integral-handoff", "[staged-root-separation]") {
+  RootFixture f(integralCover());
+  REQUIRE(f.solveLp() == LpStatus::kOptimal);
+  REQUIRE(f.data().getLp().integerFeasible());
+  const auto before = f.data().getLp().getSeparationWork();
+  const int64_t iterations = f.data().getLp().getNumLpIterations();
+  const int64_t nodes = f.data().num_nodes;
+  const int64_t leaves = f.data().num_leaves;
+  const int64_t accounted = f.data().total_lp_iterations;
+  const auto status = f.data().evaluateRootLp(f.worker(), true);
+  REQUIRE(status == LpStatus::kInfeasible);  // Root closed after normal admission.
+  REQUIRE(f.mip->modelstatus_ == HighsModelStatus::kOptimal);
+  REQUIRE(f.mip->solution_objective_ == Approx(1));
+  REQUIRE(f.data().num_nodes == nodes + 1);
+  REQUIRE(f.data().num_leaves == leaves + 1);
+  REQUIRE(f.data().getLp().getNumLpIterations() == iterations);
+  REQUIRE(f.data().total_lp_iterations == accounted);
+  REQUIRE(f.data().getLp().getSeparationWork().calls == before.calls);
+}
+
+TEST_CASE("staged-root-controlled-exception-handoff", "[staged-root-separation]") {
+  for (LpStatus status : {LpStatus::kError, LpStatus::kUnbounded}) {
+    RootFixture f;
+    REQUIRE(f.solveLp() == LpStatus::kOptimal);
+    const bool have_solution = !f.mip->solution_.empty();
+    // Deliberately injected internal status, not a claimed numerical outcome.
+    HighsStagedRootTestAccess::status(f.data().getLp(), status);
+    const int64_t count = f.data().getLp().getSeparationWork().calls;
+    const double lower = f.data().lower_bound;
+    const auto result = f.data().evaluateRootLp(f.worker(), true);
+    REQUIRE(result == status);
+    REQUIRE(f.data().getLp().getSeparationWork().calls == count);
+    REQUIRE(f.data().lower_bound == lower);
+    if (status == LpStatus::kUnbounded)
+      REQUIRE(f.mip->modelstatus_ ==
+              (have_solution ? HighsModelStatus::kUnbounded
+                             : HighsModelStatus::kUnboundedOrInfeasible));
+    else {
+      REQUIRE(f.mip->modelstatus_ == HighsModelStatus::kNotset);
+      REQUIRE(f.data().num_nodes == 0);
+    }
+  }
+  REQUIRE(HighsMipSolverData::stagedRootFailureStatus(
+              LpStatus::kError, HighsModelStatus::kTimeLimit, false) ==
+          HighsModelStatus::kTimeLimit);
+  REQUIRE(HighsMipSolverData::stagedRootFailureStatus(
+              LpStatus::kError, HighsModelStatus::kInterrupt, false) ==
+          HighsModelStatus::kInterrupt);
+  REQUIRE(HighsMipSolverData::stagedRootFailureStatus(
+              LpStatus::kError, HighsModelStatus::kNotset, false) ==
+          HighsModelStatus::kSolveError);
+  REQUIRE(HighsMipSolverData::stagedRootFailureStatus(
+              LpStatus::kInfeasible, HighsModelStatus::kInfeasible, false) ==
+          HighsModelStatus::kNotset);
+}
+
+TEST_CASE("staged-root-controlled-guards", "[staged-root-separation]") {
+  for (int scenario = 0; scenario != 5; ++scenario) {
+    RootFixture f;
+    f.highs.setOptionValue("mip_staged_root_separation", true);
+    if (scenario == 1) f.highs.setOptionValue("parallel", "on");
+    if (scenario == 2) {
+      // parallelLockActive also requires multiple workers. Construct the
+      // second worker's state but never execute work concurrently.
+      f.data().workers.emplace_back(
+          *f.mip, &f.data().getLp(), &f.data().getDomain(),
+          &f.data().getCutPool(), &f.data().getConflictPool(),
+          &f.data().getPseudoCost());
+      f.mip->setParallelLock(true);
+      REQUIRE(f.data().parallelLockActive());
+    }
+    // Controlled identity/parallel guards, not execution of parallel workers.
+    HighsDomain other_domain(f.data().getDomain());
+    HighsLpRelaxation other_lp(*f.mip);
+    const HighsDomain& domain = scenario == 3 ? other_domain : f.data().getDomain();
+    if (scenario == 4) f.sepa().setLpRelaxation(&other_lp);
+    REQUIRE(HighsStagedRootTestAccess::eligible(f.sepa(), domain) == (scenario == 0));
+    f.sepa().setLpRelaxation(&f.data().getLp());
+    f.mip->setParallelLock(false);
+  }
+}
+
+TEST_CASE("staged-root-controlled-error-exits-before-solution-use",
+          "[staged-root-separation]") {
+  RootFixture f;
+  f.highs.setOptionValue("mip_staged_root_separation", true);
+  REQUIRE(f.solveLp() == LpStatus::kOptimal);
+  HighsStagedRootTestAccess::status(f.data().getLp(), LpStatus::kError);
+  const auto work = f.data().getLp().getSeparationWork();
+  const double lower = f.data().lower_bound;
+  const auto incumbent = f.mip->solution_;
+  const int64_t nodes = f.data().num_nodes;
+  LpStatus status = LpStatus::kError;
+  HighsInt cuts = -1;
+  REQUIRE(f.data().rootSeparationRound(f.worker(), f.sepa(), cuts, status));
+  REQUIRE(status == LpStatus::kError);
+  REQUIRE(f.mip->modelstatus_ == HighsModelStatus::kSolveError);
+  REQUIRE(f.data().lower_bound == lower);
+  REQUIRE(f.mip->solution_ == incumbent);
+  REQUIRE(f.data().num_nodes == nodes);
+  REQUIRE(f.data().getLp().getSeparationWork().calls == work.calls);
+}
+
+TEST_CASE("staged-root-option-does-not-change-nonroot-entry", "[staged-root-separation]") {
+  std::vector<double> point;
+  HighsInt rows = -1;
+  int64_t iterations = -1;
+  HighsInt cuts = -1;
+  LpStatus expected = LpStatus::kNotSet;
+  for (bool enabled : {false, true}) {
+    RootFixture f;
+    f.highs.setOptionValue("mip_staged_root_separation", enabled);
+    LpStatus status = f.solveLp();
+    REQUIRE(status == LpStatus::kOptimal);
+    const HighsInt ncuts = f.sepa().separationRound(f.data().getDomain(), status);
+    if (!enabled) {
+      point = f.data().getLp().getSolution().col_value;
+      rows = f.data().getLp().numRows();
+      iterations = f.data().getLp().getNumLpIterations();
+      cuts = ncuts;
+      expected = status;
+    } else {
+      REQUIRE(f.data().getLp().getSolution().col_value == point);
+      REQUIRE(f.data().getLp().numRows() == rows);
+      REQUIRE(f.data().getLp().getNumLpIterations() == iterations);
+      REQUIRE(ncuts == cuts);
+      REQUIRE(status == expected);
+    }
+  }
+}
