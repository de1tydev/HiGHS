+HighsInt HighsSeparation::separationRoundAtRoot(
+    HighsDomain& propdomain, HighsLpRelaxation::Status& status,
+    RootStats& stats) {
+  const HighsMipSolver& solver = lp->getMipSolver();
+  stats = RootStats();
+  stats.eligible = rootStagingEligible(propdomain);
+  stats.active = stats.eligible &&
+                 solver.options_mip_->mip_staged_root_separation;
+  const bool observe = solver.options_mip_->log_dev_level >= 2;
+  const HighsInt path_calls = separators[1]->getNumCalls();
+  const double path_seconds = separators[1]->getElapsedSeconds();
+  struct RestoreObserver {
+    RootStats*& pointer;
+    RootStats* previous;
+    ~RestoreObserver() { pointer = previous; }
+  } restore{observing_root_, observing_root_};
+  observing_root_ = observe ? &stats : nullptr;
+  HighsInt ncuts = stats.active ? stagedRootRound(propdomain, status, stats)
+                               : separationRound(propdomain, status);
+  stats.path_calls = separators[1]->getNumCalls() - path_calls;
+  stats.path_seconds = separators[1]->getElapsedSeconds() - path_seconds;
+  return ncuts;
+}
