+const char* HighsSeparation::rootStopName(RootStop reason) {
+  switch (reason) {
+    case RootStop::kDomainInfeasible: return "domain_infeasible";
+    case RootStop::kLpInfeasible: return "lp_infeasible";
+    case RootStop::kNonoptimal: return "nonoptimal";
+    case RootStop::kIntegralHint: return "integral_hint";
+    case RootStop::kCutoffHint: return "cutoff_hint";
+    default: return "none";
+  }
+}
+
+HighsSeparation::RootStop HighsSeparation::rootStop(
+    const HighsDomain& domain, HighsLpRelaxation::Status status) const {
+  const HighsMipSolverData& data = *lp->getMipSolver().mipdata_;
+  if (domain.infeasible() || mipworker_.getGlobalDomain().infeasible())
+    return RootStop::kDomainInfeasible;
+  if (status == HighsLpRelaxation::Status::kInfeasible)
+    return RootStop::kLpInfeasible;
+  // resolveLp clears fractionalints even on error, limit and unbounded exits.
+  if (!lp->scaledOptimal(status)) return RootStop::kNonoptimal;
+  if (lp->integerFeasible()) return RootStop::kIntegralHint;
+  if (lp->unscaledDualFeasible(status) &&
+      std::max(data.lower_bound, lp->getObjective()) > data.optimality_limit)
+    return RootStop::kCutoffHint;
+  return RootStop::kNone;
+}
