--- a/highs/mip/HighsCmirComplement.h
+++ b/highs/mip/HighsCmirComplement.h
@@ -0,0 +1,31 @@
+#ifndef MIP_HIGHS_CMIR_COMPLEMENT_H_
+#define MIP_HIGHS_CMIR_COMPLEMENT_H_
+
+#include <cmath>
+
+// Conservative domain for the exact-arithmetic integer-complement identity.
+// These checks do not promise identical floating-point efficacy decisions.
+inline bool highsCmirIntegerComplementScale(double delta, double scale) {
+  if (!std::isfinite(delta) || delta <= 0.0 || delta > 1.0 ||
+      !std::isfinite(scale) || scale <= 0.0)
+    return false;
+  int exponent;
+  return std::frexp(scale, &exponent) == 0.5 && delta * scale == 1.0;
+}
+
+// Call only after highsCmirIntegerComplementScale(delta, scale) succeeds.
+inline bool highsCmirIntegerComplementIdentity(double coefficient, double upper,
+                                               double delta, double scale) {
+  constexpr double maxExactInteger = 4503599627370496.0;  // 2^52
+  if (!std::isfinite(coefficient) || !std::isfinite(upper) || upper < 0.0 ||
+      upper > maxExactInteger || std::floor(upper) != upper)
+    return false;
+  const double normalized = coefficient * scale;
+  if (!std::isfinite(normalized) || std::abs(normalized) > maxExactInteger ||
+      std::floor(normalized) != normalized || normalized * delta != coefficient)
+    return false;
+  const double product = normalized * upper;
+  return std::isfinite(product) && std::abs(product) <= maxExactInteger;
+}
+
+#endif
