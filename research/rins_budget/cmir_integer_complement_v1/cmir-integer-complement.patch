+#include <cmath>
+#include <limits>
+
+#include "Highs.h"
+#include "catch.hpp"
+#include "mip/HighsCmirComplement.h"
+
+TEST_CASE("CMIR-integer-complement-scale", "[cmir_integer_complement]") {
+  const auto guard = highsCmirIntegerComplementScale;
+  for (int exponent : {0, 1, 10, 52, 512, 1023}) {
+    const double delta = std::ldexp(1.0, -exponent);
+    const double scale = std::ldexp(1.0, exponent);
+    REQUIRE(guard(delta, scale));
+    REQUIRE(!guard(delta, std::nextafter(scale, 0.0)));
+    REQUIRE(!guard(delta, std::nextafter(scale, INFINITY)));
+    REQUIRE(!guard(std::nextafter(delta, 0.0), scale));
+    REQUIRE(!guard(std::nextafter(delta, INFINITY), scale));
+  }
+  for (double bad : {0.0, -1.0, 2.0, 0.3,
+                     std::numeric_limits<double>::denorm_min(),
+                     std::numeric_limits<double>::infinity(),
+                     -std::numeric_limits<double>::infinity(),
+                     std::numeric_limits<double>::quiet_NaN()})
+    REQUIRE(!guard(bad, 1.0 / bad));
+  REQUIRE(!guard(0.5, 4.0));
+  REQUIRE(!guard(0.5, -2.0));
+}
+
+TEST_CASE("CMIR-integer-complement-domain", "[cmir_integer_complement]") {
+  const auto guard = highsCmirIntegerComplementIdentity;
+  constexpr double limit = 4503599627370496.0;
+  for (double q : {-8.0, -1.0, 0.0, 1.0, 8.0}) {
+    for (double upper : {0.0, 1.0, 7.0}) {
+      REQUIRE(guard(q, upper, 1.0, 1.0));
+      REQUIRE(guard(q / 8.0, upper, 0.125, 8.0));
+      REQUIRE(!guard(std::nextafter(q, -INFINITY), upper, 1.0, 1.0));
+      REQUIRE(!guard(std::nextafter(q, INFINITY), upper, 1.0, 1.0));
+    }
+    for (double upper : {-1.0, 0.5, std::nextafter(1.0, 0.0),
+                         std::nextafter(1.0, INFINITY)})
+      REQUIRE(!guard(q, upper, 1.0, 1.0));
+  }
+  for (double bad : {std::numeric_limits<double>::infinity(),
+                     -std::numeric_limits<double>::infinity(),
+                     std::numeric_limits<double>::quiet_NaN()}) {
+    REQUIRE(!guard(bad, 1.0, 1.0, 1.0));
+    REQUIRE(!guard(1.0, bad, 1.0, 1.0));
+  }
+  REQUIRE(guard(limit, 1.0, 1.0, 1.0));
+  REQUIRE(guard(-limit, 1.0, 1.0, 1.0));
+  REQUIRE(guard(1.0, limit, 1.0, 1.0));
+  REQUIRE(guard(limit / 2.0, 2.0, 1.0, 1.0));
+  REQUIRE(guard(limit / 2.0 - 1.0, 2.0, 1.0, 1.0));
+  REQUIRE(!guard(limit + 1.0, 1.0, 1.0, 1.0));
+  REQUIRE(!guard(-limit - 1.0, 1.0, 1.0, 1.0));
+  REQUIRE(!guard(1.0, limit + 1.0, 1.0, 1.0));
+  REQUIRE(!guard(limit / 2.0 + 1.0, 2.0, 1.0, 1.0));
+  REQUIRE(!guard(-limit / 2.0 - 1.0, 2.0, 1.0, 1.0));
+  REQUIRE(!guard(std::numeric_limits<double>::max(), 1.0, 0.5, 2.0));
+  // A rounded integral product is insufficient without a reversible scale.
+  REQUIRE(!guard(1.0 / 3.0, 1.0, 0.25, 3.0));
+}
+
+TEST_CASE("CMIR-integer-complement-options", "[cmir_integer_complement]") {
+  Highs highs;
+  highs.setOptionValue("output_flag", false);
+  for (const char* name : {"mip_modk_skip_integer_complements",
+                           "mip_modk_integer_complement_log"}) {
+    bool value = true;
+    bool defaultValue = true;
+    REQUIRE(highs.getBoolOptionValues(name, &value, &defaultValue) ==
+            HighsStatus::kOk);
+    REQUIRE(!value);
+    REQUIRE(!defaultValue);
+    REQUIRE(highs.setOptionValue(name, true) == HighsStatus::kOk);
+  }
+  HighsOptions copied(highs.getOptions());
+  HighsOptions assigned;
+  assigned = copied;
+  Highs receiver;
+  REQUIRE(receiver.passOptions(assigned) == HighsStatus::kOk);
+  for (const char* name : {"mip_modk_skip_integer_complements",
+                           "mip_modk_integer_complement_log"}) {
+    bool value = false;
+    REQUIRE(receiver.getOptionValue(name, value) == HighsStatus::kOk);
+    REQUIRE(value);
+    REQUIRE(receiver.setOptionValue(name, false) == HighsStatus::kOk);
+    REQUIRE(highs.getOptionValue(name, value) == HighsStatus::kOk);
+    REQUIRE(value);
+  }
+  REQUIRE(copied.mip_modk_skip_integer_complements);
+  REQUIRE(copied.mip_modk_integer_complement_log);
+}
