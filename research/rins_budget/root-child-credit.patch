+TEST_CASE("MIP-root-child-credit-direct-timeout-import", "[root_child_credit]") {
+  // A prepared parent lets this integration exercise repeated direct children
+  // in one epoch, independently of how many dives normal root scheduling picks.
+  Highs highs;
+  highs.setOptionValue("output_flag", true);
+  highs.setOptionValue("log_to_console", false);
+  highs.setOptionValue("threads", 1);
+  highs.setOptionValue("parallel", "off");
+  highs.setOptionValue("presolve", "off");
+  highs.setOptionValue("mip_rel_gap", 0.04);
+  highs.setOptionValue("mip_heuristic_near_target_root_budget", true);
+  highs.setOptionValue("mip_heuristic_near_target_root_budget_log", true);
+  REQUIRE(highs.readModel(std::string(HIGHS_DIR) + "/check/instances/rgn.mps") ==
+          HighsStatus::kOk);
+  std::string log;
+  highs.setCallback([&](int type, const std::string& message,
+                        const HighsCallbackOutput*, HighsCallbackInput*, void*) {
+    if (type == kCallbackLogging) log += message;
+  }, nullptr);
+  REQUIRE(highs.startCallback(kCallbackLogging) == HighsStatus::kOk);
+  HighsOptions options = highs.getOptions();
+  options.mip_max_nodes = 0; // initialize a real parent without evaluating root
+  HighsLp lp = highs.getLp();
+  HighsCallback callback(nullptr);
+  HighsSolution empty;
+  highs::parallel::initialize_scheduler(1);
+  HighsTimer timer;
+  HighsProfiling profiling;
+  profiling.multi_threaded = false;
+  profiling.initialize(timer, false, false);
+  HighsMipSolver parent(callback, options, lp, empty);
+  parent.setProfiling(&profiling);
+  parent.run();
+  REQUIRE(parent.mipdata_->workers.size() == 1);
+  parent.modelstatus_ = HighsModelStatus::kNotset;
+  parent.timer_.start();
+  HighsMipWorker& worker = parent.mipdata_->workers[0];
+  HighsBasis basis;
+  basis.col_status.assign(parent.numCol(), HighsBasisStatus::kLower);
+  basis.row_status.assign(parent.numRow(), HighsBasisStatus::kBasic);
+  basis.valid = true;
+  auto child = [&](HighsSubMipOrigin origin) {
+    return parent.mipdata_->heuristics.solveSubMip(
+        worker, *parent.model_, basis, 0.0, parent.model_->col_lower_,
+        parent.model_->col_upper_, 500, 200, 12, origin);
+  };
