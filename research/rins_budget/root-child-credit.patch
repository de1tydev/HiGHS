+TEST_CASE("MIP-root-child-credit-scope", "[root_child_credit][root_child_pure]") {
+  Credit ledger;
+  ledger.finish(Incumbent(), creditIncumbent(true, 0, 100, 100), true, ObjSense::kMinimize, 5);
+  for (HighsSubMipOrigin origin : {HighsSubMipOrigin::kRootReducedCost,
+                                   HighsSubMipOrigin::kRootRens}) {
+    REQUIRE(Credit::inScope(origin, false, false, 1));
+    REQUIRE(!Credit::inScope(origin, true, false, 1));
+    REQUIRE(!Credit::inScope(origin, false, true, 1));
+    REQUIRE(!Credit::inScope(origin, false, false, 2));
+  }
+  for (HighsSubMipOrigin origin : {HighsSubMipOrigin::kOther,
+                                   HighsSubMipOrigin::kSearchRens,
+                                   HighsSubMipOrigin::kSearchRins})
+    REQUIRE(!Credit::inScope(origin, false, false, 1));
+  REQUIRE(!ledger.decide(false, true, true, 100, false).spend);
+  REQUIRE(!ledger.decide(true, false, true, 100, false).spend);
+  ledger.remaining = 0;
+  for (double existing : {0.0, -1.0,
+                          std::numeric_limits<double>::quiet_NaN()})
+    REQUIRE(!ledger.decide(true, true, true, existing, false).skip);
+  REQUIRE(!ledger.decide(true, true, true, 100, true).skip);
+  REQUIRE(ledger.decide(true, true, true, 100, false).skip);
+}
