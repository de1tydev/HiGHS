+TEST_CASE("MIP-root-child-credit-root-wiring", "[root_child_credit]") {
+  // rgn exercises actual evaluateRootNode -> reduced cost -> root RENS calls.
+  // Its first child earns credit, and the second is in (4%,8%]. The cap need
+  // not expire: assert the applied scheduling decision, never wall timing.
+  for (bool enforce : {false, true}) {
+    Highs highs;
+    highs.setOptionValue("output_flag", true);
+    highs.setOptionValue("log_to_console", false);
+    highs.setOptionValue("threads", 2);
+    highs.setOptionValue("parallel", "off");
+    highs.setOptionValue("mip_rel_gap", 0.04);
+    highs.setOptionValue("mip_heuristic_effort", 0.5);
+    highs.setOptionValue("mip_heuristic_outer_gap", true);
+    highs.setOptionValue("mip_heuristic_near_target_root_budget", enforce);
+    highs.setOptionValue("mip_heuristic_near_target_root_budget_log", true);
+    REQUIRE(highs.readModel(std::string(HIGHS_DIR) + "/check/instances/rgn.mps") ==
+            HighsStatus::kOk);
+    std::string log;
+    highs.setCallback([&](int type, const std::string& message,
+                          const HighsCallbackOutput*, HighsCallbackInput*, void*) {
+      if (type == kCallbackLogging) log += message;
+    }, nullptr);
+    REQUIRE(highs.startCallback(kCallbackLogging) == HighsStatus::kOk);
+    REQUIRE(highs.run() == HighsStatus::kOk);
+    INFO(log);
+    REQUIRE(highs.getModelStatus() == HighsModelStatus::kOptimal);
+    REQUIRE(highs.getInfo().primal_solution_status == kSolutionStatusFeasible);
+    REQUIRE(highs.getInfo().mip_gap <= 0.04);
+    REQUIRE(log.find("origin=root-reduced-cost phase=root event=learn") !=
+            std::string::npos);
+    const auto rens = log.find("origin=root-RENS phase=root depth=0");
+    REQUIRE(rens != std::string::npos);
+    const auto decision = log.substr(rens, log.find('\n', rens) - rens);
+    REQUIRE(decision.find("reason=credit") != std::string::npos);
+    REQUIRE(decision.find("existing_limit=inf") != std::string::npos);
+    REQUIRE(decision.find("proposed_limit=inf") == std::string::npos);
+    REQUIRE((decision.find("applied_limit=inf") == std::string::npos) == enforce);
+    REQUIRE(log.find("origin=root-RENS phase=root event=none charge=debit") !=
+            std::string::npos);
+    REQUIRE(log.find("termination_status=0") != std::string::npos);
+    // Nested children inherit options but do not own a policy ledger/log.
+    REQUIRE(log.find("phase=root depth=1") == std::string::npos);
+    highs.resetGlobalScheduler(true);
+  }
+}
