+TEST_CASE("MIP-root-child-credit-band", "[root_child_credit][root_child_pure]") {
+  const auto band = Credit::nearTarget;
+  // Exact binary target, with adjacent representable values on each boundary.
+  REQUIRE(!band(1, std::nextafter(0.75, 1.0), 0, 0.25, 0));
+  REQUIRE(!band(1, 0.75, 0, 0.25, 0));
+  REQUIRE(band(1, std::nextafter(0.75, 0.0), 0, 0.25, 0));
+  REQUIRE(band(1, std::nextafter(0.5, 1.0), 0, 0.25, 0));
+  REQUIRE(band(1, 0.5, 0, 0.25, 0));
+  REQUIRE(!band(1, std::nextafter(0.5, 0.0), 0, 0.25, 0));
+  REQUIRE(band(-1, -1.5, 0, 0.25, 0));
+  REQUIRE(band(0, -0.5, 1, 0.25, 0));
+  REQUIRE(band(0, -0.5, -1, 0.25, 0));
+  REQUIRE(band(-100, -110, -500, 0.01, 0)); // normalized maximum
+  REQUIRE(!band(0, -1, 0, 0.25, 0));
+  REQUIRE(!band(0, 0, 0, 0.25, 0));
+  REQUIRE(!band(1, 0.5, 0, 0.25, 0.5));
+  REQUIRE(band(1, 0.5, 0, 0.25, std::nextafter(0.5, 0.0)));
+  REQUIRE(!band(1, 0.5, 0, 0, 0));
+  REQUIRE(!band(1, 0.5, 0, -1, 0));
+  REQUIRE(!band(1, 0.5, 0, 0.25, -1));
+  REQUIRE(!band(1, 2, 0, 0.25, 0));
+  // Large offset: compute the numerator before adding the offset.
+  const long double offset = std::ldexp(1.0L, 60);
+  REQUIRE(band(64, 32, offset, 24 / offset, 0));
+  for (long double bad : {std::numeric_limits<long double>::infinity(),
+                         -std::numeric_limits<long double>::infinity(),
+                         std::numeric_limits<long double>::quiet_NaN()}) {
+    REQUIRE(!band(bad, 0.5, 0, 0.25, 0));
+    REQUIRE(!band(1, bad, 0, 0.25, 0));
+    REQUIRE(!band(1, 0.5, bad, 0.25, 0));
+    REQUIRE(!band(1, 0.5, 0, bad, 0));
+    REQUIRE(!band(1, 0.5, 0, 0.25, bad));
+  }
+  const long double max = std::numeric_limits<long double>::max();
+  REQUIRE(!band(max, -max, 0, 0.25, 0));
+  REQUIRE(!band(max, 0, max, 0.25, 0));
+  REQUIRE(!band(max, 0, 0, max, 0));
+  REQUIRE(!band(max, 0, 0, 1, 0)); // 2*target overflows
+}
