+TEST_CASE("MIP-root-child-credit-epochs", "[root_child_credit][root_child_pure]") {
+  Credit ledger;
+  const double offset = std::ldexp(1.0, 60);
+  Incumbent absent;
+  Incumbent old = creditIncumbent(true, 4, double(offset + 64), 64);
+  Incumbent rounded = creditIncumbent(true, 4, double(offset + 32), 32);
+  REQUIRE(old.original == rounded.original);
+  ledger.finish(absent, old, true, ObjSense::kMinimize, 5);
+  REQUIRE(ledger.synchronize(old) == std::string("none"));
+  REQUIRE(ledger.remaining == 5);
+  REQUIRE(ledger.synchronize(rounded) == std::string("upper"));
+  REQUIRE(!ledger.valid); // external normalized-only incumbent change
+  REQUIRE(!ledger.decide(true, true, true, 100, false).spend);
+  ledger.finish(absent, old, true, ObjSense::kMinimize, 5);
+  ledger.charge(ledger.decide(true, true, true, 100, false), 2);
+  REQUIRE(ledger.remaining == 3); // charged before import/reset
+  REQUIRE(!Credit::improved(true, old, rounded, ObjSense::kMinimize));
+  REQUIRE(ledger.finish(old, rounded, true, ObjSense::kMinimize, 2) ==
+          std::string("upper"));
+  REQUIRE(!ledger.valid);
+  REQUIRE(!ledger.decide(true, true, true, 100, false).skip);
+  for (int change = 0; change < 4; ++change) {
+    ledger.finish(absent, old, true, ObjSense::kMinimize, 5);
+    Incumbent next = old;
+    if (change == 0) ++next.restart;
+    if (change == 1) next.original = std::nextafter(old.original, kHighsInf);
+    if (change == 2) --next.upper;
+    if (change == 3) next.feasible = false;
+    REQUIRE(ledger.synchronize(next) != std::string("none"));
+    REQUIRE(!ledger.valid);
+  }
+}
