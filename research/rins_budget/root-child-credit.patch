+TEST_CASE("MIP-root-child-credit-ledger", "[root_child_credit][root_child_pure]") {
+  Credit ledger;
+  Incumbent absent;
+  Incumbent current = creditIncumbent(true, 0, 100, 100);
+  auto decision = ledger.decide(true, true, true, kHighsInf, false);
+  REQUIRE(!decision.spend);
+  REQUIRE(!decision.skip);
+  REQUIRE(ledger.finish(absent, current, false, ObjSense::kMinimize, 5) ==
+          std::string("none"));
+  REQUIRE(!ledger.valid);
+  REQUIRE(ledger.finish(absent, current, true, ObjSense::kMinimize, 5) ==
+          std::string("learn"));
+  REQUIRE(ledger.initial == 5);
+  REQUIRE(ledger.remaining == 5);
+  decision = ledger.decide(true, true, true, kHighsInf, false);
+  REQUIRE(decision.spend);
+  REQUIRE(decision.limit == 5);
+  REQUIRE(ledger.charge(decision, 2) == std::string("debit"));
+  REQUIRE(ledger.remaining == 3);
+  REQUIRE(!Credit::improved(true, current, current, ObjSense::kMinimize));
+  ledger.finish(current, current, true, ObjSense::kMinimize, 2);
+  REQUIRE(ledger.remaining == 3); // accepted nonimprovement earns nothing
+  decision = ledger.decide(true, true, true, kHighsInf, false);
+  REQUIRE(decision.limit == 3);
+  ledger.charge(decision, 4); // includes actual overshoot, even on infeasibility
+  REQUIRE(ledger.remaining == 0);
+  decision = ledger.decide(true, true, true, kHighsInf, false);
+  REQUIRE(decision.skip);
+  REQUIRE(decision.limit == 0);
+  REQUIRE(ledger.remaining == 0); // a skipped launch neither charges nor learns
+  Incumbent better = creditIncumbent(true, 0, 99, 99);
+  REQUIRE(ledger.finish(current, better, true, ObjSense::kMinimize, 2) ==
+          std::string("renew"));
+  REQUIRE(ledger.remaining == 2);
+  decision = ledger.decide(true, true, false, 100, false);
+  REQUIRE(!decision.spend);
+  ledger.charge(decision, 10);
+  ledger.finish(better, better, false, ObjSense::kMinimize, 10);
+  REQUIRE(ledger.remaining == 2); // out-of-band failures cannot spend
+  Incumbent best = creditIncumbent(true, 0, 98, 98);
+  ledger.finish(better, best, true, ObjSense::kMinimize, 7);
+  REQUIRE(ledger.remaining == 7); // out-of-band successful root child can learn
+  REQUIRE(ledger.decide(true, true, true, 3, false).limit == 3);
+  for (double elapsed : {-1.0, kHighsInf,
+                         std::numeric_limits<double>::quiet_NaN()}) {
+    ledger.finish(absent, current, true, ObjSense::kMinimize, 5);
+    ledger.charge(ledger.decide(true, true, true, 100, false), elapsed);
+    REQUIRE(!ledger.valid);
+    ledger.finish(current, better, true, ObjSense::kMinimize, elapsed);
+    REQUIRE(!ledger.valid);
+  }
+  for (ObjSense sense : {ObjSense::kMinimize, ObjSense::kMaximize}) {
+    REQUIRE(Credit::improved(true, absent, current, sense));
+    REQUIRE(!Credit::improved(false, absent, current, sense));
+    REQUIRE(!Credit::improved(true, current, absent, sense));
+  }
+  Incumbent max_better = creditIncumbent(true, 0, 101, 99);
+  REQUIRE(Credit::improved(true, current, max_better, ObjSense::kMaximize));
+  REQUIRE(!Credit::improved(true, current, better, ObjSense::kMaximize));
+  max_better.upper = 100;
+  REQUIRE(!Credit::improved(true, current, max_better, ObjSense::kMaximize));
+}
