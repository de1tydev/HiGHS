+TEST_CASE("MIP-root-child-credit-observe-regression", "[root_child_credit]") {
+  for (bool parallel : {false, true}) {
+    for (bool maximize : {false, true}) {
+      double objective = 0, bound = 0;
+      int64_t nodes = -1;
+      HighsInt iterations = -1;
+      for (int mode = 0; mode < (parallel ? 3 : 2); ++mode) {
+        Highs highs;
+        highs.setOptionValue("output_flag", true);
+        highs.setOptionValue("log_to_console", false);
+        highs.setOptionValue("threads", 2);
+        highs.setOptionValue("parallel", parallel ? "on" : "off");
+        highs.setOptionValue("mip_rel_gap", 0.02);
+        highs.setOptionValue("mip_heuristic_effort", 0.5);
+        highs.setOptionValue("mip_heuristic_near_target_root_budget", mode == 2);
+        highs.setOptionValue("mip_heuristic_near_target_root_budget_log", mode != 0);
+        REQUIRE(highs.readModel(std::string(HIGHS_DIR) + "/check/instances/rgn.mps") ==
+                HighsStatus::kOk);
+        HighsLp lp = highs.getLp();
+        lp.offset_ = -20;
+        if (maximize) {
+          for (double& cost : lp.col_cost_) cost = -cost;
+          lp.offset_ = -lp.offset_;
+          lp.sense_ = ObjSense::kMaximize;
+        }
+        REQUIRE(highs.passModel(lp) == HighsStatus::kOk);
+        std::string log;
+        highs.setCallback([&](int type, const std::string& message,
+                              const HighsCallbackOutput*, HighsCallbackInput*, void*) {
+          if (type == kCallbackLogging) log += message;
+        }, nullptr);
+        REQUIRE(highs.startCallback(kCallbackLogging) == HighsStatus::kOk);
+        REQUIRE(highs.run() == HighsStatus::kOk);
+        REQUIRE(highs.getModelStatus() == HighsModelStatus::kOptimal);
+        REQUIRE(highs.getInfo().primal_solution_status == kSolutionStatusFeasible);
+        const auto& info = highs.getInfo();
+        if (mode == 0) {
+          objective = info.objective_function_value;
+          bound = info.mip_dual_bound;
+          nodes = info.mip_node_count;
+          iterations = info.simplex_iteration_count;
+          REQUIRE(log.find("RootChildCredit") == std::string::npos);
+        } else {
+          REQUIRE(info.objective_function_value == objective);
+          REQUIRE(info.mip_dual_bound == bound);
+          REQUIRE(info.mip_node_count == nodes);
+          REQUIRE(info.simplex_iteration_count == iterations);
+          if (parallel)
+            REQUIRE(log.find("RootChildCredit") == std::string::npos);
+          else
+            REQUIRE(log.find("mode=observe") != std::string::npos);
+        }
+        highs.resetGlobalScheduler(true);
+      }
+    }
+  }
+}
