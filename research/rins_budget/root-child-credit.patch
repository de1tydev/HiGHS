+using Credit = HighsRootChildCredit;
+using Incumbent = Credit::Incumbent;
+
+static Incumbent creditIncumbent(bool feasible, HighsInt restart,
+                                double original, double upper) {
+  Incumbent result;
+  result.feasible = feasible;
+  result.restart = restart;
+  result.original = original;
+  result.upper = upper;
+  return result;
+}
