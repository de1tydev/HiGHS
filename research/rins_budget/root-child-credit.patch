+TEST_CASE("MIP-root-child-credit-local-timeout", "[root_child_credit]") {
+  Highs highs;
+  highs.setOptionValue("output_flag", false);
+  HighsOptions options = highs.getOptions();
+  options.time_limit = -1;
+  HighsLp lp;
+  lp.num_col_ = 1;
+  lp.col_cost_ = {1};
+  lp.col_lower_ = {0};
+  lp.col_upper_ = {200};
+  lp.integrality_ = {HighsVarType::kInteger};
+  lp.a_matrix_.num_col_ = 1;
+  lp.a_matrix_.start_ = {0, 0};
+  HighsCallback callback(nullptr);
+  HighsSolution solution;
+  HighsMipSolver parent(callback, options, lp, solution);
+  parent.mipdata_.reset(new HighsMipSolverData(parent));
+  auto record = parent.initialiseTerminatorRecord(2);
+  parent.initialiseTerminator(2, 0, record.data());
+  HighsMipSolver child(callback, options, lp, solution, true, 1);
+  child.initialiseTerminator(parent);
+  child.mipdata_.reset(new HighsMipSolverData(child));
+  child.modelstatus_ = HighsModelStatus::kNotset;
+  child.timer_.start();
+  child.solution_ = {100};
+  child.solution_objective_ = 100;
+  child.bound_violation_ = child.row_violation_ = child.integrality_violation_ = 0;
+  REQUIRE(child.mipdata_->checkLimits());
+  REQUIRE(child.modelstatus_ == HighsModelStatus::kTimeLimit);
+  REQUIRE(child.termination_status_ == HighsModelStatus::kNotset);
+  REQUIRE(parent.termination_status_ == HighsModelStatus::kNotset);
+  REQUIRE(record[0] == HighsModelStatus::kNotset);
+  REQUIRE(record[1] == HighsModelStatus::kNotset);
+  REQUIRE(child.solution_ == std::vector<double>{100});
+  HighsCDouble objective;
+  double bound, row, integer;
+  REQUIRE(parent.solutionFeasible(&lp, child.solution_, nullptr,
+                                  bound, row, integer, objective));
+  child.modelstatus_ = HighsModelStatus::kNotset;
+  record[1] = HighsModelStatus::kHighsInterrupt;
+  REQUIRE(child.mipdata_->checkLimits());
+  REQUIRE(child.termination_status_ == HighsModelStatus::kHighsInterrupt);
+  REQUIRE(child.modelstatus_ == HighsModelStatus::kNotset);
+  REQUIRE(parent.termination_status_ == HighsModelStatus::kNotset);
+  child.timer_.stop();
+  highs.resetGlobalScheduler(true);
+}
